# Google Sheets
GOOGLE_SHEETS_ID=your_google_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON=base64_encoded_service_account_json

# Google Analytics
GA_PROPERTY_ID=properties/123456789

# Notion
NOTION_API_KEY=secret_xxx
NOTION_CUSTOMERS_DB_ID=your_notion_database_id

# Zoho CRM
ZOHO_CLIENT_ID=your_client_id
ZOHO_CLIENT_SECRET=your_client_secret
ZOHO_REFRESH_TOKEN=your_refresh_token
ZOHO_API_DOMAIN=https://www.zohoapis.eu
ZOHO_ACCOUNTS_URL=https://accounts.zoho.eu

# Auth0 Management API (Machine-to-Machine App) – nur für den Cronjob (MAU-Metrik)
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_CLIENT_ID=your_m2m_client_id
AUTH0_CLIENT_SECRET=your_m2m_client_secret

# Dashboard-Login via Auth0 (separate "Regular Web Application"!)
# Auf Railway daraus generiert start.sh die .streamlit/secrets.toml.
AUTH0_LOGIN_DOMAIN=your-tenant.eu.auth0.com
AUTH0_LOGIN_CLIENT_ID=your_webapp_client_id
AUTH0_LOGIN_CLIENT_SECRET=your_webapp_client_secret
AUTH0_REDIRECT_URI=https://your-app.up.railway.app/oauth2callback
# Zufälliger String, z.B. `openssl rand -hex 32`
AUTH0_COOKIE_SECRET=change_me_random_secret
# Nur diese E-Mail-Domain darf das Dashboard sehen
ALLOWED_EMAIL_DOMAIN=@stromify.de
# NUR LOKAL: Login komplett deaktivieren (niemals auf Railway setzen!)
# DISABLE_AUTH=true
